# App
APP_NAME=PortableAI API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# Security — override in production!
# In production ENVIRONMENT=production requires a strong JWT_SECRET (>= 32
# chars, not the dev default), explicit CORS_ORIGINS and TRUSTED_HOSTS, and
# DEBUG=false. The app fails fast otherwise.
JWT_SECRET=dev-secret-change-me-0123456789abcdef
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database
DATABASE_URL=postgresql+asyncpg://portableai:portableai@localhost:5432/portableai

# Redis
REDIS_URL=redis://localhost:6379/0

# CORS + trusted hosts
# CORS_ORIGINS is a JSON list of allowed browser origins.
CORS_ORIGINS=["http://localhost:3000"]
# TRUSTED_HOSTS is a JSON list of allowed Host headers (set in production).
# Empty = allow all hosts (development convenience only).
# TRUSTED_HOSTS=["portableai.example.com"]

# Request limits
# MAX_REQUEST_BYTES=1048576

# OpenAI-compatible provider — optional; leave empty to disable the provider
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_TIMEOUT=60.0
# OPENAI_MODEL=gpt-4o-mini

# Embeddings — fake (offline) default; set openai to use the real provider
# EMBEDDING_PROVIDER_ID=fake
# EMBEDDING_DIMENSIONS=384
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_EMBEDDING_TIMEOUT=30.0
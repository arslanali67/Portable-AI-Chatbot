# App
APP_NAME=PortableAI API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# Security — override in production!
# In production ENVIRONMENT=production requires a strong JWT_SECRET (>= 32
# chars, not the dev default), explicit CORS_ORIGINS and TRUSTED_HOSTS, and
# DEBUG=false. The app fails fast otherwise.
JWT_SECRET=dev-secret-change-me-0123456789abcdef
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# BYOK credential encryption — required. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# No rotation mechanism: losing this key makes stored credentials permanently undecryptable.
# Also used to encrypt the platform-wide Stripe credential (billing).
AI_CREDENTIAL_ENCRYPTION_KEY=change-me-generate-a-real-fernet-key

# Stripe billing — webhook signing secret, required. Generated when the
# webhook endpoint is registered in the Stripe dashboard; not the Stripe API
# secret key itself (that's platform-wide but admin-editable at runtime via
# the platform dashboard, so it's DB-stored, not here).
STRIPE_WEBHOOK_SECRET=whsec_change-me
# Stripe Price IDs for each paid tier (Free has none — no Stripe object).
# STRIPE_PRICE_ID_PRO=price_...
# STRIPE_PRICE_ID_ENTERPRISE=price_...

# Database
DATABASE_URL=postgresql+asyncpg://portableai:portableai@localhost:5432/portableai

# Redis
REDIS_URL=redis://localhost:6379/0

# CORS + trusted hosts
# CORS_ORIGINS is a JSON list of allowed browser origins.
CORS_ORIGINS=["http://localhost:3000"]
# TRUSTED_HOSTS is a JSON list of allowed Host headers (set in production).
# Empty = allow all hosts (development convenience only).
# TRUSTED_HOSTS=["portableai.example.com"]

# Request limits
# MAX_REQUEST_BYTES=1048576

# ============================================================
# OpenAI-Compatible AI Provider
# ============================================================

# Gemini example:
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# OPENAI_TIMEOUT=60.0
# OPENAI_MODEL=gemini-3.6-flash

# Embeddings — fake (offline) default; set openai to use the real provider
# EMBEDDING_PROVIDER_ID=fake
# EMBEDDING_DIMENSIONS=384
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_EMBEDDING_TIMEOUT=30.0
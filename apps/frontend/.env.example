# Frontend environment — variable names only, never real values.

# API base URL for deployed (cross-origin) builds, e.g.
#   VITE_API_BASE_URL=https://portableai-api.onrender.com
#
# In development leave this UNSET: Vite proxies /api and /widget.js to the
# backend (see vite.config.ts, VITE_API_PROXY_TARGET) and the app uses the
# existing relative-path behavior.
VITE_API_BASE_URL=
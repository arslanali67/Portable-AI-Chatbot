# Copy to infrastructure/.env and fill in real values.
#   cp .env.example .env
#   docker compose -f infrastructure/docker-compose.prod.yml up -d --build

# App environment — must be "production" in deployment. This activates
# fail-fast config validation (strong secret, explicit origins/hosts, no debug).
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# PostgreSQL
POSTGRES_DB=portableai
POSTGRES_USER=portableai
POSTGRES_PASSWORD=change-me-strong-password

# Security — REQUIRED, min 32 chars, never the dev default.
JWT_SECRET=change-me-to-a-long-random-secret-0123456789
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS + trusted hosts (JSON arrays)
# Frontend origin(s) that may call the API directly (dev only in prod; same-origin
# proxying is used so an empty list is fine when the nginx frontend proxies).
CORS_ORIGINS=["http://localhost:3000"]
# Host headers the API will accept — REQUIRED in production.
TRUSTED_HOSTS=["localhost"]

# Optional OpenAI-compatible provider credentials (leave empty to keep fake provider)
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Port the nginx frontend binds on the host
HTTP_PORT=8080